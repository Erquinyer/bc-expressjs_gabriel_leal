{
  "name": "semana06-api-notaria",
  "version": "1.0.0",
  "description": "Proyecto semana 06 — API REST con MongoDB + Mongoose (dominio Notaría)",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/server.js",
    "seed": "tsx --env-file=.env src/seed.ts"
  },
  "dependencies": {
    "express": "5.1.0",
    "mongoose": "9.4.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.15.21",
    "tsx": "4.19.4",
    "typescript": "5.8.3"
  }
}
